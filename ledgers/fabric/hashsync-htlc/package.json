{
    "name": "hashsync-htlc",
    "version": "1.0.0",
    "description": "Hash registry synchronised with Ethereum through hash time-locked attempts",
    "main": "index.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "lint": "eslint *.js */**.js",
        "pretest": "npm run lint",
        "test": "nyc mocha --recursive",
        "start": "fabric-chaincode-node start"
    },
    "engineStrict": true,
    "license": "Apache-2.0",
    "dependencies": {
        "fabric-contract-api": "~2.5",
        "fabric-shim": "~2.5",
        "json-stringify-deterministic": "^1.0.0",
        "sort-keys-recursive": "^2.1.0"
    },
    "devDependencies": {
        "chai": "^4.4.1",
        "eslint": "^8.57.0",
        "mocha": "^10.4.0",
        "nyc": "^15.1.0",
        "sinon": "^18.0.0"
    },
    "nyc": {
        "exclude": ["coverage/**", "test/**", "index.js", ".eslintrc.js"],
        "reporter": ["text-summary"],
        "all": true
    }
}
